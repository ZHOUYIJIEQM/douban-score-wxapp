<scrollLoad bindloadData="scrollHandler">
  <view class="more-movie-page">
    <view 
      class="movie-item"
      wx:for="{{listArr}}"
      wx:for-index="index" 
      wx:for-item="item"
      wx:key="index"
      data-id="{{item.id}}"
      bindtap="goMovieDetail"
    >
      <image
        class="movie-img"
        src="{{item.movieImage}}"
        mode="widthFix"
        lazy-load="true"
      />
      <view class="text-box">
        <view class="movie-name eli">{{item.name}}</view>
        <view class="score-box">
          <view><starRate star="{{item.score}}" /></view>
          <text>{{item.score}}</text>
        </view>
      </view>
    </view>
  </view>
</scrollLoad>